# 配置先: /etc/mini-cdc-demo/engineering.env（chmod 600, root:root）
# パスワードを含むのでリポジトリにはコミットしない。
# パスワードはURLエンコードして埋める（? @ : / % などが含まれる場合、
# 生のままだとURLの区切り文字と誤認識されて接続に失敗する）。
DATABASE_URL=postgres://postgres:<AURORA_PASSWORD>@<AURORA_ENDPOINT>:5432/postgres
PORT=3101
# ALB のパスベースルーティングに合わせた prefix（ALB はパスを書き換えないため必須）
BASE_PATH=/engineering
